---
format: json
layout: ''
metadata:
  name: Todo Categories API - Delete
  enabled: true
  file_type: page
method: post
redirect_to: ''
redirect_url: ''
---
{%- if context.post_params != blank -%}
{%- parse_json params -%}{{ context.post_params }}{%- endparse_json -%}
{%- else -%}
{%- assign params = context.params -%}
{%- endif -%}
{%- assign id = params.id | default: '' | strip -%}

{%- if id == blank -%}
{"error":"Category id is required"}
{%- else -%}
  {%- graphql result = "todo_categories/delete_todo_category", id: id -%}
  {%- if result.record_delete.id == blank -%}
{"error":"Failed to delete category"}
  {%- else -%}
{"success":true,"id":"{{ result.record_delete.id }}"}
  {%- endif -%}
{%- endif -%}
