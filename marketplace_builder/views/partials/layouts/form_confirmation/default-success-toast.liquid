---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: default
  studio_dynamic/files:
  - views/partials/layouts/form_confirmation/default-success-toast.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: default-success-toast
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_s3
  studio_dynamic/layout_name: Default success toast
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default success toast
  studio_dynamic/sub_module_id: '0'
  studio_dynamic/make_global_form: false
---
{% if context.session.form_id != blank and context.session.form_fc != blank %}
  {% capture sitebuilder_uniq_component_id %}sitegurus_component_{% increment sitegurus_gen_uniq_component_id %}{% endcapture %}
  <div id="toastSuccess_{{sitebuilder_uniq_component_id}}" class="flex items-center w-full max-w-xs p-4 mb-4 text-gray-500 bg-white rounded-lg shadow dark:text-gray-400 dark:bg-gray-800 fixed right-0 sm:right-8 bottom-4" role="alert">
    <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-success-500 bg-success-50 rounded-lg dark:bg-success-900 dark:text-success-400">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
    </div>
    <div class="ml-3 text-sm font-normal">
      Thank you for your submission {{form.name}}! We've emailed you a confirmation and we'll get back to you as soon as possible.
    </div>
    <button type="button" class="ml-auto -mx-1.5 -my-1.5 bg-white text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex h-8 w-8 dark:text-gray-500 dark:hover:text-white dark:bg-gray-800 dark:hover:bg-gray-700" data-dismiss-target="#toastSuccess_{{sitebuilder_uniq_component_id}}" aria-label="Close">
      <span class="sr-only">Close</span>
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
    </button>
  </div>
  {% comment %} Clear the notification for next page load. {% endcomment %}
  {% session form_id = null %}
  {% session form_fc = null %}
{% endif %}
