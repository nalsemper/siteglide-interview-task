---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: default
  studio_dynamic/files:
  - views/partials/layouts/modules/module_2/user-menu-and-cart/item.liquid
  - views/partials/layouts/modules/module_2/user-menu-and-cart/wrapper.liquid
  - views/partials/layouts/modules/module_5/log_out/user-menu-and-cart/logout.liquid
  - views/partials/layouts/modules/module_5/log_in/user-menu-and-cart/login.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: user-menu-and-cart
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_2
  studio_dynamic/layout_name: User menu and cart
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: User menu and cart
  studio_dynamic/sub_module_id: '1'
  studio_dynamic/make_global_form: false
---
{% comment %} ---Settings--- {% endcomment %}
{% comment %} ------Search Results URL------
The URL where you've outputted a search results layout. {% endcomment %}
{% assign search_results_url = "/search-results" %}
{% comment %} ------User Favourites URL------
The URL where you've outputted a user favourites layout, or leave null {% endcomment %}
{% assign user_favourites_url = "/my-favourites" %}
{% comment %} ------Cart URL------
The URL where you've outputted a cart layout, or leave null. Alternatively, this <a> could be manually exchanged for a
modal-like Cart Layout Button. {% endcomment %}
{% assign cart_url = "/cart" %}
{% comment %} ------Dashboard URL------
The URL where you've outputted a Dashboard/ My Account/ Secure Zone layout. {% endcomment %}
{% assign dashboard_url = "/my-account" %}
{% comment %} ------User CRM Image Field------
The field name in the CRM where a User's profile Picture is stored. If not stored, put null. {% endcomment %}
{% assign user_crm_image_field = null %}
{% comment %} ------login_redirect------ The URL the user will be redirected to after logging in. {% endcomment %}
{% assign login_redirect = dashboard_url %}
{% comment %} ------logout_redirect------ The URL the user will be redirected to after logging out. Default is current page. {% endcomment %}
{% assign logout_redirect = context.location.pathname %}
{% comment %} ------sign-up URL------ The URL where the user will create an account. {% endcomment %}
{% assign sign_up_url = "/sign-up" %}

{% comment %} ---End Settings--- {% endcomment %}
{% capture sitebuilder_uniq_component_id %}sitegurus_component_{% increment sitegurus_gen_uniq_component_id %}{% endcapture %}
<header class="bg-white border-gray-200
dark:bg-gray-800">
  <nav class="px-4 mx-auto max-w-screen-xl lg:px-6 py-2.5">
    <div class="flex flex-wrap justify-between items-center">
      <a href="/" class="flex items-center">
        <img class="mr-3 h-6 sm:h-9 dark:hidden" src="{% if context.exports.company_information.properties.logo != blank %}{{context.exports.company_information.properties.logo | asset_url}}{% else %}https://flowbite.com/docs/images/logo.svg{% endif %}" alt="{{context.exports.company_information.properties.company_name}} logo">
        <img class="mr-3 h-6 sm:h-9 hidden dark:block" src="{% if context.exports.company_information.properties.logo_white != blank %}{{context.exports.company_information.properties.logo_white | asset_url}}{% else %}https://flowbite.com/docs/images/logo.svg{% endif %}" alt="{{context.exports.company_information.properties.company_name}} logo">
      </a>
      <div class="flex items-center lg:order-2">
        <button id="theme-toggle" aria-label="toggle dark mode" type="button" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 mx-2">
          <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>
        <a href="{{cart_url}}" class="hidden lg:inline-flex justify-between text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 mx-2" id="cartLink">
          <span class="sr-only">Cart</span>
          <svg class="w-6 h-6 mr-1 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M4 4a1 1 0 0 1 1-1h1.5a1 1 0 0 1 .979.796L7.939 6H19a1 1 0 0 1 .979 1.204l-1.25 6a1 1 0 0 1-.979.796H9.605l.208 1H17a3 3 0 1 1-2.83 2h-2.34a3 3 0 1 1-4.009-1.76L5.686 5H5a1 1 0 0 1-1-1Z" clip-rule="evenodd"/>
          </svg>
          {% assign cart_parsed = context.session.cart | parse_json %}
          {% assign total_quantity = 0 %}
          {% for item in cart_parsed %}
            {% assign total_quantity = total_quantity | plus: item[1].quantity %}
          {% endfor %}
          <span data-s-e-live-cart-quantity class="font-medium">{{total_quantity}}</span>
        </a>
        {% if context.current_user.id == blank %}
          {% capture login_layout -%}{{layout}}/login{%- endcapture %}
          {%- include 'login_form', layout: login_layout, redirect: login_redirect -%}
        {% else %}
          <button type="button" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 mx-2" id="user-menu-button" aria-expanded="false" type="button" data-dropdown-toggle="icon_dropdown_{{sitebuilder_uniq_component_id}}">
            <span class="sr-only">Open user menu</span>
            {% if user_crm_image_field != blank and context.exports.current_user.properties[user_crm_image_field] != blank %}
              <img class="w-8 h-8 rounded-full" src="{{context.exports.current_user.properties[user_crm_image_field] | asset_url }}" alt="user photo">
            {% else %}
              <svg class="w-6 h-6 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4h-4Z" clip-rule="evenodd"/>
              </svg>


            {% endif %}
          </button>
          <!-- Dropdown menu -->
          <div class="hidden z-50 my-4 text-base list-none bg-white rounded divide-y divide-gray-100 shadow dark:bg-gray-700 dark:divide-gray-600" id="icon_dropdown_{{sitebuilder_uniq_component_id}}">
            <div class="py-3 px-4">
              <span class="block text-sm text-gray-900 dark:text-white">{{context.exports.current_user.name}}</span>
              <span class="block text-sm font-medium text-gray-500 truncate dark:text-gray-400">{{context.exports.current_user.email}}</span>
            </div>
            <ul class="py-1" aria-labelledby="dropdown">
              <li>
                <a href="{{dashboard_url}}" class="block py-2 px-4 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white">Dashboard</a>
              </li>
              <li>
                <a href="{{cart_url}}" class="block py-2 px-4 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white">Cart</a>
              </li>
              <li>
                {% capture logout_layout -%}{{layout}}/logout{%- endcapture %}
                {%- include 'logout_button', layout: logout_layout, redirect: logout_redirect -%}
              </li>
            </ul>
          </div>
        {% endif %}
        <button data-collapse-toggle="mobile-menu_{{sitebuilder_uniq_component_id}}" type="button" class="inline-flex items-center p-2 ml-3 text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600" aria-controls="mobile-menu_{{sitebuilder_uniq_component_id}}" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
          <svg class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
        </button>
      </div>
      <div class="hidden justify-between items-center w-full lg:flex lg:w-auto lg:order-1" id="mobile-menu_{{sitebuilder_uniq_component_id}}">
        <ul class="flex flex-col mt-4 lg:flex-row lg:space-x-8 lg:mt-0 lg:text-sm font-medium">
          {%- include 'modules/siteglide_menu/get/get_items', item_layout: 'item' -%}
          <li {% if cart_url == context.location.pathname %}aria-current="page"{% endif %} class="flex items-center lg:hidden">
            <a class="flex justify-between items-center py-2 pl-3 pr-4 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 dark:hover:text-white dark:border-gray-700 dark:hover:bg-gray-700  dark:lg:hover:bg-transparent" href="{{cart_url}}">
              <span class="mr-3">Cart</span>
              <svg class="w-6 h-6 mr-3 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M4 4a1 1 0 0 1 1-1h1.5a1 1 0 0 1 .979.796L7.939 6H19a1 1 0 0 1 .979 1.204l-1.25 6a1 1 0 0 1-.979.796H9.605l.208 1H17a3 3 0 1 1-2.83 2h-2.34a3 3 0 1 1-4.009-1.76L5.686 5H5a1 1 0 0 1-1-1Z" clip-rule="evenodd"/>
              </svg>
              
              <span data-s-e-live-cart-quantity class="">{{total_quantity}}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

