---
metadata:
  studio_theme: flowbite
  studio_dynamic/type: default
  studio_dynamic/files:
  - views/partials/layouts/modules/module_2/duotone-footer/item.liquid
  - views/partials/layouts/modules/module_2/duotone-footer/wrapper.liquid
  studio_dynamic/theme: Flowbite
  studio_dynamic/layout: duotone-footer
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_2
  studio_dynamic/layout_name: Duotone Footer
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Duotone Footer
  studio_dynamic/sub_module_id: '1'
  studio_dynamic/make_global_form: false
---
{% comment %} ---Settings--- {% endcomment %}
{% comment %} ---End Settings--- {% endcomment %}
{% capture sitebuilder_uniq_component_id %}sitegurus_component_{% increment sitegurus_gen_uniq_component_id %}{% endcapture %}

<footer class="bg-secondary-700 border-gray-200 dark:bg-secondary-900">
  <div class="mx-auto w-full max-w-screen-xl p-4 py-6 lg:py-20">
      <div class="lg:flex lg:gap-10">
        <div class="max-w-64 space-y-6 mb-8">
            <a href="/" class="flex items-center">
                {% comment %} <img class="h-8 me-3 dark:hidden" src="{% if context.exports.company_information.properties.logo != blank %}{{context.exports.company_information.properties.logo | asset_url}}{% else %}https://flowbite.com/docs/images/logo.svg{% endif %}" alt="{{context.exports.company_information.properties.company_name}} logo"> {% endcomment %}
                <img class="h-8 me-3" src="{% if context.exports.company_information.properties.logo_white != blank %}{{context.exports.company_information.properties.logo_white | asset_url}}{% else %}https://flowbite.com/docs/images/logo.svg{% endif %}" alt="{{context.exports.company_information.properties.company_name}} logo">
            </a>
            <p class="text-white text-base font-light">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt.
            </p>
            <div class="flex gap-1 md:gap-4">
              {% if context.exports.company_information.properties.facebook_account != blank %}
                <a href="{{context.exports.company_information.properties.facebook_account}}" class="text-white hover:text-primary-500 p-1 bg-transparent hover:bg-white border border-white rounded-lg dark:hover:text-secondary-700">
                    <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" d="M13.135 6H15V3h-1.865a4.147 4.147 0 0 0-4.142 4.142V9H7v3h2v9.938h3V12h2.021l.592-3H12V6.591A.6.6 0 0 1 12.592 6h.543Z" clip-rule="evenodd"/>
                    </svg>
                    <span class="sr-only">Facebook Page</span>
                </a>
              {% endif %}
              {% if context.exports.company_information.properties.instagram_account != blank %}
                <a href="{{context.exports.company_information.properties.instagram_account}}" class="text-white hover:text-primary-500 p-1 bg-transparent hover:bg-white border border-white rounded-lg ms-5 dark:hover:text-secondary-700">
                    <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                      <path fill="currentColor" fill-rule="evenodd" d="M3 8a5 5 0 0 1 5-5h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8Zm5-3a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h8a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3H8Zm7.597 2.214a1 1 0 0 1 1-1h.01a1 1 0 1 1 0 2h-.01a1 1 0 0 1-1-1ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm-5 3a5 5 0 1 1 10 0 5 5 0 0 1-10 0Z" clip-rule="evenodd"/>
                    </svg>
                    <span class="sr-only">Instagram Page</span>
                </a>
              {% endif %}
              {% if context.exports.company_information.properties.twitter_account != blank %}
                <a href="{{context.exports.company_information.properties.twitter_account}}" class="text-white hover:text-primary-500 p-1 bg-transparent hover:bg-white border border-white rounded-lg ms-5 dark:hover:text-secondary-700">
                    <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" d="M22 5.892a8.178 8.178 0 0 1-2.355.635 4.074 4.074 0 0 0 1.8-2.235 8.343 8.343 0 0 1-2.605.981A4.13 4.13 0 0 0 15.85 4a4.068 4.068 0 0 0-4.1 4.038c0 .31.035.618.105.919A11.705 11.705 0 0 1 3.4 4.734a4.006 4.006 0 0 0 1.268 5.392 4.165 4.165 0 0 1-1.859-.5v.05A4.057 4.057 0 0 0 6.1 13.635a4.192 4.192 0 0 1-1.856.07 4.108 4.108 0 0 0 3.831 2.807A8.36 8.36 0 0 1 2 18.184 11.732 11.732 0 0 0 8.291 20 11.502 11.502 0 0 0 19.964 8.5c0-.177 0-.349-.012-.523A8.143 8.143 0 0 0 22 5.892Z" clip-rule="evenodd"/>
                    </svg>
                    <span class="sr-only">Twitter Page</span>
                </a>
              {% endif %}
              {% if context.exports.company_information.properties.linkedin_account != blank %}
                <a href="{{context.exports.company_information.properties.linkedin_account}}" class="text-white hover:text-primary-500 p-1 bg-transparent hover:bg-white border border-white rounded-lg ms-5 dark:hover:text-secondary-700">
                    <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" d="M12.51 8.796v1.697a3.738 3.738 0 0 1 3.288-1.684c3.455 0 4.202 2.16 4.202 4.97V19.5h-3.2v-5.072c0-1.21-.244-2.766-2.128-2.766-1.827 0-2.139 1.317-2.139 2.676V19.5h-3.19V8.796h3.168ZM7.2 6.106a1.61 1.61 0 0 1-.988 1.483 1.595 1.595 0 0 1-1.743-.348A1.607 1.607 0 0 1 5.6 4.5a1.601 1.601 0 0 1 1.6 1.606Z" clip-rule="evenodd"/>
                      <path d="M7.2 8.809H4V19.5h3.2V8.809Z"/>
                    </svg>
                    <span class="sr-only">LinkedIn Page</span>
                </a>
              {% endif %}
            </div>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-10 pb-16 lg:gap-6 lg:pb-8">
          {%- include 'modules/siteglide_menu/get/get_items', item_layout: 'item' -%}
        </div>
        <div class="grid grid-cols-1 sm:gap-10 sm:grid-cols-2 lg:gap-0 lg:flex lg:flex-col lg:max-w-80 lg:w-full">
          {% if context.exports.company_information.properties.email_address != blank or context.exports.company_information.properties.address_line_1 != blank or context.exports.company_information.properties.phone_number != blank %}
            <div class="col-span-1 pb-8">
                <h2 class="mb-8 text-lg font-semibold text-white">Contact Us</h2>
                <ul class="text-white font-light text-base space-y-4">
                  {% if context.exports.company_information.properties.email_address != blank %}
                    <li class="flex gap-2">
                      <svg class="w-4 h-4 mt-1 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M2.038 5.61A2.01 2.01 0 0 0 2 6v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6c0-.12-.01-.238-.03-.352l-.866.65-7.89 6.032a2 2 0 0 1-2.429 0L2.884 6.288l-.846-.677Z"/>
                        <path d="M20.677 4.117A1.996 1.996 0 0 0 20 4H4c-.225 0-.44.037-.642.105l.758.607L12 10.742 19.9 4.7l.777-.583Z"/>
                      </svg>
                      <a href="mailto:{{context.exports.company_information.properties.email_address}}" class="hover:underline hover:text-primary-400">{{ context.exports.company_information.properties.email_address }}</a>
                    </li>
                  {% endif %}
                  {% if context.exports.company_information.properties.address_line_1 != blank %}
                    <li class="flex gap-2">
                      <svg class="w-4 h-4 mt-1 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M11.906 1.994a8.002 8.002 0 0 1 8.09 8.421 7.996 7.996 0 0 1-1.297 3.957.996.996 0 0 1-.133.204l-.108.129c-.178.243-.37.477-.573.699l-5.112 6.224a1 1 0 0 1-1.545 0L5.982 15.26l-.002-.002a18.146 18.146 0 0 1-.309-.38l-.133-.163a.999.999 0 0 1-.13-.202 7.995 7.995 0 0 1 6.498-12.518ZM15 9.997a3 3 0 1 1-5.999 0 3 3 0 0 1 5.999 0Z" clip-rule="evenodd"/>
                      </svg>
                      <div>
                        <p>{{ context.exports.company_information.properties.address_line_1 }}</p>
                        <p>{{ context.exports.company_information.properties.address_line_2 }}</p>
                      </div>
                    </li>
                  {% endif %}
                  {% if context.exports.company_information.properties.phone_number != blank %}
                    <li class="flex gap-2">
                      <svg class="w-4 h-4 mt-1 shrink-0" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M7.978 4a2.553 2.553 0 0 0-1.926.877C4.233 6.7 3.699 8.751 4.153 10.814c.44 1.995 1.778 3.893 3.456 5.572 1.68 1.679 3.577 3.018 5.57 3.459 2.062.456 4.115-.073 5.94-1.885a2.556 2.556 0 0 0 .001-3.861l-1.21-1.21a2.689 2.689 0 0 0-3.802 0l-.617.618a.806.806 0 0 1-1.14 0l-1.854-1.855a.807.807 0 0 1 0-1.14l.618-.62a2.692 2.692 0 0 0 0-3.803l-1.21-1.211A2.555 2.555 0 0 0 7.978 4Z"/>
                      </svg>
                      <p>{{ context.exports.company_information.properties.phone_number }}</p>
                    </li>
                  {% endif %}
                </ul>
            </div>
          {% endif %}
            <div class="col-span-1">
              <h2 class="mb-8 text-lg font-semibold text-white">Newsletter</h2>
              <form class="max-w-sm">
                <div class="flex">
                    <div class="relative w-full">
                        <input type="search" id="search-dropdown" class="block p-5 w-full z-20 text-sm text-secondary-900 bg-secondary-50 rounded-2xl border-s-secondary-50 border-s-2 border border-secondary-300 focus:ring-primary-500 focus:border-primary-500" placeholder="Enter your email" required />
                        <button type="submit" class="absolute top-0 end-0 px-5 py-2.5 text-base font-medium h-full text-white bg-primary-500 rounded-e-2xl hover:bg-primary-600 focus:ring-4 focus:outline-none focus:ring-primary-300">
                          Subscribe
                          <span class="sr-only">Subscribe</span>
                        </button>
                    </div>
                </div>
              </form>


            </div>
        </div>
      </div>
  </div>
</footer>
  
