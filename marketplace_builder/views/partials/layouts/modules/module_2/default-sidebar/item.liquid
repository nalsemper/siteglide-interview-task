---
metadata:
  studio_theme: flowbite
  studio_dynamic/type: default
  studio_dynamic/files:
  - views/partials/layouts/modules/module_2/default-sidebar/item.liquid
  - views/partials/layouts/modules/module_2/default-sidebar/wrapper.liquid
  studio_dynamic/theme: Flowbite
  studio_dynamic/layout: default-sidebar
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_2
  studio_dynamic/layout_name: Default sidebar
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default sidebar
  studio_dynamic/sub_module_id: '3'
  studio_dynamic/make_global_form: false
---
  {%- comment -%} If this item has children, output the item as a heading. This layout does not support more than 2 levels of menu. {%- endcomment -%}
  {%- if this['is_parent'] and _level == 1 -%}
    <li>
      <button type="button" class="flex items-center p-2 w-full text-base font-normal text-gray-900 rounded-lg transition duration-75 group hover:bg-gray-100 dark:text-white dark:hover:bg-gray-700" aria-controls="dropdown_{{sitebuilder_uniq_component_id}}_{{this['link_name'] | slugify}}" data-collapse-toggle="dropdown_{{sitebuilder_uniq_component_id}}_{{this['link_name'] | slugify}}">
        <span class="flex-1 ml-3 text-left whitespace-nowrap">{{this['link_name']}}</span>
        <svg aria-hidden="true" class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
      </button>
      <ul id="dropdown_{{sitebuilder_uniq_component_id}}_{{this['link_name'] | slugify}}" class="hidden py-2 space-y-2">
        {%- assign _next_level = _level | plus: 1 -%}
        {%- include 'modules/siteglide_menu/get/get_items', level: _next_level, parent_id: this['forced_id'], item_layout: 'item' -%}
      </ul>
    </li>
  {%- else -%}
    {%- comment -%} Else output dropdown children or single item {%- endcomment -%}
    {% if _level == 1 %}
      <li>
        <a href="{{this['link_url']}}" {% if this['link_target'] %} target="{{this['link_target']}}"{% endif %} class="flex items-center p-2 text-base font-normal text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group">
          <span class="ml-3">{{this['link_name']}}</span>
        </a>
      </li>
    {% else %}
      <li>
        <a href="{{this['link_url']}}" {% if this['link_target'] %} target="{{this['link_target']}}"{% endif %} class="flex items-center p-2 pl-11 w-full text-base font-normal text-gray-900 rounded-lg transition duration-75 group hover:bg-gray-100 dark:text-white dark:hover:bg-gray-700">{{this['link_name']}}</a>
      </li>
    {% endif %}
  {%- endif -%}
