{% comment %} ---End Settings--- {% endcomment %}

<div>
  {% form %}
    <button type="button" class="block py-2 px-4 text-sm text-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 dark:text-gray-200 dark:hover:text-white" onclick="siteglide_logout_process(this,'{{logout_redirect}}')">Log Out</button>
  {% endform %}
</div>
