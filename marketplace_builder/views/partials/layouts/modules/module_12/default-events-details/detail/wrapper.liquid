    label: Event List View URL
    default: "/events"
  - id: sidebar
    type: boolean
    label: Show Sidebar
    default: true
  - id: event_parent_category
    type: text
    label: Event Parent Category
    default:
  - id: cf_physical_street_address
    type: text
    label: Physical Street Address Field ID
    default:
  - id: cf_physical_address_locality
    type: text
    label: Physical Address Locality Field ID
    default:
  - id: cf_physical_postal_code
    type: text
    label: Physical Postal Code Field ID
    default:
  - id: cf_physical_address_region
    type: text
    label: Physical Address Region Field ID
    default:
  - id: cf_physical_address_country
    type: text
    label: Physical Address Country Field ID
    default:
  - id: cf_virtual_event_url
    type: text
    label: Virtual Event URL Field ID
    default:
  studio_theme: studiokit
  studio_library: studiokit
