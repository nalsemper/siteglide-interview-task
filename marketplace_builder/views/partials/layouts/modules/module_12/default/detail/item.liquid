<div class="default-event">
	<h3>{{this['name']}}</h3>
	{% if this.category_array[0] %}
		{% for category in this.category_array %}
			<a href="{{context.headers.PATH_INFO}}?category={{category}}" title="">{{context.exports.categories.items[category].name}}</a>
			<!-- Replace {{context.headers.PATH_INFO}} with the URL for your Page which displays a List View --> 
		{% endfor %}
	{% endif %}
	<p>{{this['Description']}}</p>
	{% if this['Location - Address'] %}
		<h4>Location</h4>
		<p>{{this['Location - Address']}}</p>
	{% endif %}
	<ul>
		<li>
			<h4>Event Start</h4>
			<p data-date>{{this['Event Start'] | date: "%d/%m/%Y %H:%M"}}</p>
		</li>
		<li>
			<h4>Event End</h4>
			<p data-date>{{this['Event End'] | date: "%d/%m/%Y %H:%M" }}</p>
		</li>
		{% include "modules/siteglide_authors/get/get_item_author", author_id: this.properties.module_field_12_4, author_layout: "design_system/1/author", author_layout_type: "detail" %}
	</ul>
</div>

{% if this.properties.module_field_12_8 %}
	{% assign ticket_ids = this.properties.module_field_12_8 | join: "," %}
	{%- include 'ecommerce/products', layout: 'ticket/default', item_ids: ticket_ids, type: 'list', per_page: 20 -%}
{% endif %}