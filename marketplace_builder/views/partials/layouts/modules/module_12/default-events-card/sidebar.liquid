---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: list
  studio_dynamic/files:
  - views/partials/layouts/modules/module_12/default-events-card/list/wrapper.liquid
  - views/partials/layouts/modules/module_12/default-events-card/list/item.liquid
  - views/partials/layouts/modules/module_12/default-events-card/search.liquid
  - views/partials/layouts/modules/module_12/default-events-card/sidebar.liquid
  - views/partials/layouts/modules/module_12/default-events-card/archive.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: default-events-card
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_12
  studio_dynamic/layout_name: Default events card
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default events card
  studio_dynamic/sub_module_id: '0'
  studio_dynamic/make_global_form: false
---
<aside aria-label="Sidebar">
  <form data-sg-live-update-controls="sidebar">
    <div class="overflow-y-auto py-4 px-3 bg-gray-50 rounded dark:bg-gray-800 mb-4">
      <div class="mb-4">
        <h4 class="text-lg dark:text-white mb-2">Categories</h4>
        <div>
          {% for category in context.exports.categories.data %}
            {% if category[1].parent == event_parent_category or event_parent_category == blank %}
              <div class="inline-flex items-center bg-primary-100 hover:bg-primary-200 text-primary-800 text-xs font-semibold mr-2 mb-2 px-2.5 py-0.5 rounded dark:bg-primary-200 dark:text-primary-800 dark:hover:bg-primary-300 ">
                <input id="category_{{category[0]}}" type="checkbox" name="category" value="{{category[0]}}" class="w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded focus:ring-primary-500 dark:focus:ring-primary-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600" {% if filters_values_from_URL == true %}{% assign params_category = context.params.category | split: "," %}{% if params_category contains category[0] %}checked{% endif %}{% endif %}>
                <label for="category_{{category[0]}}" class="py-0.5 ml-2 dark:text-primary-800 text-primary-800 text-xs font-semibold">{{category[1].name | replace: " ", "&nbsp;"}}</label>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% capture archive_layout %}{{layout}}{% endcapture %}
      {%- include 'modules/siteglide_events/get/get_events_archive', archive_layout: archive_layout, archive_layout_type: "archive" -%}

      {% capture search %}layouts/modules/module_12/{{layout}}/search{% endcapture %}
      {%- include search -%}
    </div>
  </form>
</aside>
