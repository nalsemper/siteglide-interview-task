---
metadata:
  fields:
  - id: main_heading
    type: text
    label: Main Heading
    default: Testimonials
  - id: caption
    type: text
    label: Caption
    default: Explore the whole collection of open-source web components and elements
      built with the utility classes from Tailwind
  settings:
  - id: list_url
    type: text
    label: URL For More Testimonials
    default: "/testimonials"
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: list
  studio_dynamic/files:
  - views/partials/layouts/modules/module_8/testimonial-cards/list/wrapper.liquid
  - views/partials/layouts/modules/module_8/testimonial-cards/list/item.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: testimonial-cards
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_8
  studio_dynamic/layout_name: Testimonial cards
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Testimonial cards
  studio_dynamic/sub_module_id: '0'
  studio_dynamic/make_global_form: false
---
{% comment %} ---Settings:--- {% endcomment %}
{% comment %} ------ URL for more Testimonials------ {% endcomment %}
{% assign list_url = settings.list_url | default: "/testimonials" %}
{% comment %} ---End Settings--- {% endcomment %}

<section data-motion-group>
  <div class="container py-24 md:py-28 text-center">
    <div class="mx-auto max-w-screen-sm">
      <h2 data-motion-text>{{this.main_heading | default: "Testimonials"}}</h2>
      <p class="mx-auto">{{this.caption | default: "Explore the whole collection of open-source web components and elements built with the utility classes from Tailwind"}}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-2" data-motion-group>
      {%- include 'modules/siteglide_system/get/get_items', item_layout: 'item' -%}
    </div>
    {%- if _show_pagination == 'false' and pagination_layout != blank and pagination_layout != "default" -%}
      {%- include 'modules/siteglide_system/get/get_pagination', pagination_layout: _pagination_layout -%}
    {%- else -%}
      <div class="mt-10 text-center">
        <a href="{{list_url}}" class="button-secondary">Show more...</a>
      </div>
    {%- endif -%}
  </div>
</section>
