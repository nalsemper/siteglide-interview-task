---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: list
  studio_dynamic/files:
  - views/partials/layouts/modules/module_4/visual-image-with-heading/list/wrapper.liquid
  - views/partials/layouts/modules/module_4/visual-image-with-heading/list/item.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: visual-image-with-heading
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_4
  studio_dynamic/layout_name: Visual image with heading
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Visual image with heading
  studio_dynamic/sub_module_id: '0'
  studio_dynamic/make_global_form: false
---
{% capture sitebuilder_uniq_component_id %}sitegurus_component_{% increment sitegurus_gen_uniq_component_id %}{% endcapture %}
<section class=" ">
  <div class="container">
    <div class="swiper" data-sitebuilder-swiper="{{sitebuilder_uniq_component_id}}">
      <!-- Additional required wrapper -->
      <div class="swiper-wrapper">
        <!-- Slides -->
        {%- include 'modules/siteglide_system/get/get_items', item_layout: 'item' -%}
      </div>
      <!-- If we need pagination -->
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>
<script>
  if(!window.sitebuilderSwiperConfig ) {
    window.sitebuilderSwiperConfig  = {};
  }
  window.sitebuilderSwiperConfig['{{sitebuilder_uniq_component_id}}'] = {
    initiated: false,
    //Choose any configuration from the docs here: https://swiperjs.com/swiper-api
    config: {
      slidesPerView: 1,
      slidesPerGroup: 1,
      spaceBetween: 60,
      grabCursor: true,
      autoplay: {
        delay: 5000
      },
      longSwipes: true,
      longSwipesRatio: 0.1,
      longSwipesMs: 300,
      // If we need pagination
      pagination: {
        el: `[data-sitebuilder-swiper='{{sitebuilder_uniq_component_id}}'] .swiper-pagination`,
        clickable: true
      }
    }
  }
  if(typeof window.sitebuilderSwiperInit == 'function') {
    //In case script is loaded already. Run initiation again. Sliders in the config will only be initiated if initiated property is set to false.
    window.sitebuilderSwiperInit();
  }
</script>
{% if context.exports.sitebuilder.sliderJSLoaded == blank %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css"/>
  <script async src="{{'modules/module_357/js/sitegurus_sliders_javascript_api.1.min.js' | asset_url }}"></script>
  {% assign sliderJSLoaded = true %}
  {% export sliderJSLoaded, namespace: sitebuilder %}
{% endif %}
