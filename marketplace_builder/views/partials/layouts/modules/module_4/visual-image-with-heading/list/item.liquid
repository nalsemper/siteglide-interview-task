---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: list
  studio_dynamic/files:
  - views/partials/layouts/modules/module_4/visual-image-with-heading/list/wrapper.liquid
  - views/partials/layouts/modules/module_4/visual-image-with-heading/list/item.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: visual-image-with-heading
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_4
  studio_dynamic/layout_name: Visual image with heading
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Visual image with heading
  studio_dynamic/sub_module_id: '0'
  studio_dynamic/make_global_form: false
---
<div class="swiper-slide">
  <div class="max-w-full grid lg:gap-8 xl:gap-0 lg:py-16 lg:grid-cols-12">
    <div class="mr-auto place-self-center lg:col-span-7 space-y-4 pb-8 md:pb-0">
      {% if this['Title'] != blank %}
      <h1 class="">{{ this['Title'] }}</h1>
      {% endif %}
      {% if this['Description'] != blank %}<div class="format dark:format-invert">{{ this['Description'] | html_safe}}</div>{% endif %}
      {% if this['Button Name'] != blank or this['Button Link'] != blank %}
      <a href="{{this['Button Link']}}" class="button">
        {{this['Button Name']}}
        <svg class="w-5 h-5 ml-2 -mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
      </a>
      {% endif %}
    </div>
    <div class="hidden lg:mt-0 lg:col-span-5 lg:flex">
      <img src="{{ this['Image'] | asset_url }}" alt="{{ this['Image Alt'] }}">
    </div>        
  </div>
</div>
