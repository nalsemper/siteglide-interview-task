---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: list
  studio_dynamic/files:
  - views/partials/layouts/modules/module_4/default-full-width-image-swiper/list/wrapper.liquid
  - views/partials/layouts/modules/module_4/default-full-width-image-swiper/list/item.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: default-full-width-image-swiper
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_4
  studio_dynamic/layout_name: Default full-width image swiper
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default full-width image swiper
  studio_dynamic/sub_module_id: '0'
  studio_dynamic/make_global_form: false
---
<div class="swiper-slide ">
  <div class="w-full h-full bg-cover bg-no-repeat bg-center" style="background-image: url('{{ this['Image'] | asset_url }}');">
    <div class="py-8 px-4 h-full mx-auto max-w-screen-xl text-center lg:py-16 lg:px-12 space-y-4 flex flex-col justify-center items-center">
      {% if this['Title'] != blank %}<h1 class="text-white">{{ this['Title'] }}</h1>{% endif %}
      {% if this['Description'] != blank %}
        <div class="flex align-center justify-center">
          <div class="format dark:format-invert mb-2 text-lg font-normal text-white lg:text-xl sm:px-16 xl:px-48">{{ this['Description'] | html_safe}}</div>
        </div>
      {% endif %}
      {% if this['Button Name'] != blank or this['Button Link'] != blank %}
        <div class="mb-8 lg:mb-16 space-y-4 sm:space-y-0 sm:space-x-4">
          <a href="{{this['Button Link']}}" class="button">
            <span>{{this['Button Name']}}</span>
            <svg class="ml-2 -mr-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>
