<div class="sectionPadding">
	<div class="container">
		<div class="row text-center justify-content-center">
			<div class="col-12 col-md-7">
				<h2>Payment Gateway</h2>
				<h4>Submit a new item</h4>
			</div>
		</div>
		<div class="row justify-content-center pt-4">
			<div class="col-12 col-md-7">
				{% form -%}
					<div class="row mt-4">
						<div class="col">
							<label for="name">Name</label>
							<input class="form-control required" name="{{ form_builder.fields.properties.name.name }}" value="{{this.name}}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_1">Name</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_1'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_2">Active</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_2'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_3">Public Key (Live)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_3'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_4">Secret Key (Live)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_4'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_5">Type</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_5'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_6">Public Key (Test)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_6'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_7">Secret Key (Test)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_7'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_8">In Test Mode?</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_8'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_9">Webhook Secret (Live)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_9'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_10">Webhook Secret (Test)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_10'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_11">PayPal Client ID (Sandbox)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_11'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_12">PayPal Client Secret (Sandbox)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_12'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_15">PayPal Client ID (Live)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_15'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/payment_gateway_16">PayPal Client Secret (Live)</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/payment_gateway_16'].name }}" type="text">
						</div>
					</div>

					<div class="row mt-4">
						<div class="col">
							<div class="form-error"></div>
							<button type="button" class="btn buttonAccent" onClick="s_form_submit_v2(this,'module_14/payment_gateway')">Submit</button>
						</div>
					</div>
					<input class="form-control" name="{{ form_builder.fields.properties.enabled.name }}" value="{{_enabled}}" type="hidden">
					<input class="form-control" name="{{ form_builder.fields.properties.expiry_date.name }}" value="{{_expiry_date}}" type="hidden">
					<input class="form-control" name="{{ form_builder.fields.properties.release_date.name }}" value="{{_release_date}}" type="hidden">
					<input id="s_redirect" value="" type="hidden">
					<input class="form-control upload_dir" value="{{_upload_dir}}" type="hidden">
					<input class="form-control" name="{{ form_builder.fields.properties.slug.name }}" value="{{_slug}}" type="hidden">
				{% endform -%}
			</div>
		</div>
	</div>
</div>