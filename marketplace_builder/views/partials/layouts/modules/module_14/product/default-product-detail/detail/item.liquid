{% capture structured_data %}layouts/modules/module_14/product/{{layout}}/structured_data{% endcapture %}
{%- include structured_data, product_brand: this.properties[cf_product_brand] -%}

<div class="lg:grid lg:grid-cols-2 lg:gap-8 xl:gap-16">
  <div class="shrink-0 max-w-md lg:max-w-lg mx-auto">
		<img data-sg-main-image class="w-full" src="{{this['Image'] | asset_url}}" alt="{{this.name}}" />
		{% for attribute in this.product_attributes %}
			{% for option in attribute.product_attribute_options %}
				<img loading="lazy" data-sg-attr-image="{{option.id}}" src="{{option.image | asset_url}}" alt="{{this.name}}" class="hidden">
			{% endfor %}
		{% endfor %}
	</div>
	{% comment %} End of column 1 {% endcomment %}
	<div class="mt-6 sm:mt-8 lg:mt-0">
		<h3 class="">{{this['name']}}</h1>
		<div class="mt-4 sm:items-center sm:gap-4 sm:flex">
			{% assign dis_float = this.price.price_display | plus: 0.0 %}
			{% assign chr_float = this.price.price_charge | plus: 0.0 %}
			{% if show_display_price_crossed_out == true and this.price.price_display != blank and chr_float != dis_float and dis_float != 0 %}
				<p class="text-2xl font-extrabold text-gray-900 sm:text-3xl dark:text-white" >{{this.price.currency_symbol}}{{this.price.price_display | divided_by: 100.0 | format_number: precision: 2 }}</p>
			{% endif %}
			<p class="text-2xl font-extrabold text-gray-900 sm:text-3xl dark:text-white {% if show_display_price_crossed_out == true and this.price.price_display != blank and chr_float != dis_float and dis_float != 0 %} inline-block ml-2 {% endif %}" data-price-control="{{this.price.price_charge}}" data-currency-control="{{this.price.currency_symbol}}">
				{% comment %} This price will change as attributes with prices are selected. If you have attributes with prices, you may wish to modify or disable the display price output above to avoid confusion. {% endcomment %}
			</p>
			
			{% comment %}<div class="flex items-center gap-2 mt-2 sm:mt-0">
				<div class="flex items-center gap-1">
					<svg
						class="w-4 h-4 text-yellow-300"
						aria-hidden="true"
						xmlns="http://www.w3.org/2000/svg"
