																	<tr style="border-bottom:2px solid #ecedee; text-align:left; padding:15px 0;">
																		<th style="padding: 0 15px 0 0;" width="25%">Product Name</th>
																		<th style="padding: 0 15px 0 0;" width="25%">Attributes</th>
																		<th style="padding: 0 15px;" width="10%">QTY</th>
																		<th style="padding: 0 15px;" width="25%">Product Code</th>
																		<th style="padding: 0 0 0 15px;" align="right" width="15%">Price</th>
																	</tr>
																	{%- for product in this.order_products -%}
																		<tr style="border-bottom:1px solid #ecedee;">
																			<td style="padding: 5px 15px 5px 0; font-weight: 200;">{{ product.product_name }}</td>
																			<td style="padding: 5px 15px 5px 0; font-weight: 200;">
																				{% for attribute in product.order_product_attributes -%}
																					{% if attribute.product_attribute_name != blank -%}
																						{{ attribute.product_attribute_name }}: {{ attribute.product_attribute_option_name }}
																					{% endif -%}
																				{% endfor -%}
																			</td>
																			<td style="padding: 5px 15px; font-weight: 200;">{{ product.quantity }}</td>
																			<td style="padding: 5px 15px; font-weight: 200;">{{ product.product_code }}</td>
																			<td style="padding: 5px 5px 5px 15px; font-weight: 200;" align="right">{{ product.currency_symbol }}{{ product.price }}</td>
																		</tr>
																	{%- endfor -%}
																</table>
