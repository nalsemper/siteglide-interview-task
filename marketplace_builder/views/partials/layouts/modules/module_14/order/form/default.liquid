					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/order_24">Shipping Method Price - Tax Amount</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/order_24'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/order_25">Price - Cart Total Before Tax</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/order_25'].name }}" type="text">
