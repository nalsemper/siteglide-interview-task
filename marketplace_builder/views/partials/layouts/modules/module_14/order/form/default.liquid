<div class="sectionPadding">
	<div class="container">
		<div class="row text-center justify-content-center">
			<div class="col-12 col-md-7">
				<h2>Orders</h2>
				<h4>Submit a new item</h4>
			</div>
		</div>
		<div class="row justify-content-center pt-4">
			<div class="col-12 col-md-7">
				{% form -%}
					<div class="row mt-4">
						<div class="col">
							<label for="name">Name</label>
							<input class="form-control required" name="{{ form_builder.fields.properties.name.name }}" value="{{this.name}}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/order_1">User ID</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/order_1'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/order_2">Email</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/order_2'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
