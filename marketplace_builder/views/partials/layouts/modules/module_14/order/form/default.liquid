					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/order_20">Discount Code - Amount</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/order_20'].name }}" type="text">
