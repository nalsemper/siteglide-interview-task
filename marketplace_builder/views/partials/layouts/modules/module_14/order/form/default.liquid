							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/order_8'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/order_9">Total Price</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/order_9'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
