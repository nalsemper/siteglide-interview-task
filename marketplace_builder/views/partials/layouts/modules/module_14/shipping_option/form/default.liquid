<div class="sectionPadding">
	<div class="container">
		<div class="row text-center justify-content-center">
			<div class="col-12 col-md-7">
				<h2>Shipping Option</h2>
				<h4>Submit a new item</h4>
			</div>
		</div>
		<div class="row justify-content-center pt-4">
			<div class="col-12 col-md-7">
				{% form -%}
					<div class="row mt-4">
						<div class="col">
							<label for="name">Name</label>
							<input class="form-control required" name="{{ form_builder.fields.properties.name.name }}" value="{{this.name}}" type="text">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/shipping_option_1">Name</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/shipping_option_1'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 number_float">
						<div class="col">
							<label for="module_field_14/shipping_option/price/aud/1">Chargeable Price AUD</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/shipping_option/price/aud/1'].name }}" type="number" value="0" step="0.01">
						</div>
					</div>
					<div class="row mt-4 number_float">
						<div class="col">
							<label for="module_field_14/shipping_option/price/aud/2">Display Only Price AUD</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/shipping_option/price/aud/2'].name }}" type="number" value="0" step="0.01">
						</div>
					</div>
					<div class="row mt-4 input_text">
						<div class="col">
							<label for="module_field_14/shipping_option/price/aud/3">Currency Symbol AUD</label>
							<input class="form-control sg-form-control" name="{{ form_builder.fields.properties['module_field_14/shipping_option/price/aud/3'].name }}" type="text">
						</div>
					</div>
					<div class="row mt-4 select_multi">
						<div class="col">
							<label for="module_field_14/shipping_option/price/aud/4">Tax Code AUD</label>
							<select class="" name="{{ form_builder.fields.properties['module_field_14/shipping_option/price/aud/4'].name }}[]" multiple>
							</select>
						</div>
					</div>
					<div class="row mt-4 number_float">
