---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: list
  studio_dynamic/files:
  - views/partials/layouts/modules/module_14/product/live-updating-cart/list/wrapper.liquid
  - views/partials/layouts/modules/module_14/product/live-updating-cart/list/item.liquid
  - views/partials/layouts/modules/module_14/discount_code/live-updating-cart.liquid
  - views/partials/layouts/modules/module_14/shipping_option/live-updating-cart.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: live-updating-cart
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_14
  studio_dynamic/layout_name: Live-updating cart
  studio_dynamic/live_updates: 'true'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Live Updating Cart
  studio_dynamic/sub_module_id: '3'
  studio_dynamic/make_global_form: false
---
<div class="card rounded-2xl bg-base-50 dark:bg-base-900/20 p-6">
  <form class="flex flex-col gap-4">
    <div>
      <label for="{{ sitebuilder_uniq_component_id }}_discount_code" class="text-sm font-medium">Do you have a voucher or gift card?</label>
      <input type="text" id="{{ sitebuilder_uniq_component_id }}_discount_code" data-s-e-discount-code value="{%- if discount_code != blank -%}{{ discount_code }}{%- endif -%}" class="mt-2 block w-full rounded-lg border border-base-200 bg-base-50 px-3 py-2.5 text-sm dark:border-base-700 dark:bg-base-900" placeholder="" required />
    </div>
    {%- if discount_code == blank -%}
      <button class="button w-full justify-center" id="s_e_discount_apply" onclick="s_e_cart_discount_code('{{ context.exports.cart_base_price.data | json }}', s_e_discount_error)">Apply Code</button>
    {%- else -%}
      <button class="button-secondary w-full justify-center text-danger-400" id="s_e_discount_remove" onclick="s_e_cart_discount_code_remove()">Remove Code</button>
    {%- endif -%}
    {%- if discount_code != blank and discount_minimum -%}
      <div class="rounded-lg border border-primary-200 bg-primary-50 p-4 text-sm dark:border-primary-800 dark:bg-primary-900/20" role="alert">
        <span class="font-medium">Discount Terms</span> This code will only be valid on orders over: {{ context.exports.cart_currency.data }}{%- include 'modules/siteglide_ecommerce/ecommerce/price_formatter', price_data: discount_minimum -%}
      </div>
    {%- endif -%}
  </form>
</div>

<script>
  function s_e_discount_error(error) {
    swal.fire({
      position: 'bottom-end',
      icon: 'error',
      title: error.message,
      showConfirmButton: false,
      timer: 2000,
      toast: true,
      width: '24em',
      padding: '1.5rem',
      showCloseButton: true,
      customClass: {
        popup: 'flex items-center w-full max-w-xs rounded-2xl bg-base-50 p-4 dark:bg-base-900',
        title: 'ms-3 text-sm',
        closeButton: 'ms-auto inline-flex h-8 w-8 items-center justify-center rounded-lg p-1.5 hover:bg-base-100 dark:hover:bg-base-700',
      }
    });
  }
</script>

{% if context.exports.sitebuilder.sweetalert == blank %}
	<script id="sweetalert_script" async src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	{% assign sweetalert = true %}
	{% export sweetalert, namespace: "sitebuilder" %}
{% endif %}
