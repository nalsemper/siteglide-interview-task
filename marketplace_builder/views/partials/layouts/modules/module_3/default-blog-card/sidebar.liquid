---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: list
  studio_dynamic/files:
  - views/partials/layouts/modules/module_3/default-blog-card/list/wrapper.liquid
  - views/partials/layouts/modules/module_3/default-blog-card/list/item.liquid
  - views/partials/layouts/modules/module_3/default-blog-card/search.liquid
  - views/partials/layouts/modules/module_3/default-blog-card/sidebar.liquid
  - views/partials/layouts/modules/module_3/default-blog-card/archive.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: default-blog-card
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_3
  studio_dynamic/layout_name: Default blog card
  studio_dynamic/live_updates: 'true'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default blog card
  studio_dynamic/sub_module_id: '0'
  studio_dynamic/make_global_form: false
---
<aside aria-label="Sidebar" data-motion-group>
  <form data-sg-live-update-controls="sidebar">
    <div class="mb-4 rounded-2xl border border-base-200 bg-base-50 p-4 dark:border-base-700 dark:bg-base-900/20">
      <div class="mb-4">
        <h3>Categories</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {% for category in context.exports.categories.data %}
            {% if category[1].parent == blog_parent_category or blog_parent_category == blank %}
              <label class="button-secondary inline-flex items-center gap-2 !rounded-full !px-3 !py-1 text-xs">
                <input id="category_{{category[0]}}" type="checkbox" name="category" value="{{category[0]}}" class="h-4 w-4 rounded border-base-300 text-primary-500 dark:border-base-600" {% if filters_values_from_URL == true %}{% assign params_category = context.params.category | split: "," %}{% if params_category contains category[0] %}checked{% endif %}{% endif %}>
                <span>{{category[1].name | replace: " ", "&nbsp;"}}</span>
              </label>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      {% capture archive_layout %}{{layout}}{% endcapture %}
      {%- include 'modules/siteglide_blog/get/get_blog_archive', archive_layout: archive_layout, archive_layout_type: "archive" -%}
      {% capture search %}layouts/modules/module_3/{{layout}}/search{% endcapture %}
      {%- include search -%}
    </div>
  </form>
</aside>
