
<div class="col-span-full">
  <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300" for="{{form_html_id}}_{{field_id}}">{{label}} {% if validation contains 'required' %}<span>*</span>{% endif %}</label>
  <div data-sg-rich-text-wrapper class="format dark:format-invert max-w-none block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-info-500 focus:border-info-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-info-500 dark:focus:border-info-500 ">
    <textarea {{attributes}} id="{{form_html_id}}_{{field_id}}" name="{{name}}" {% if label != blank %}data-sg-validation-label="{{label}}" data-sg-validation-id="{{field_id}}" {% endif %} class="{{validation}}" type="text" {{validation}}>{{value}}</textarea>
  </div>
</div>
{% if attributes contains 'data-sg-rich-text' %}
  {% comment %} First textarea is the one seen by Form Submission. But is hidden from the user, and updated when the interface is updated. {% endcomment %}
  <textarea data-rich-text rows="10" class="hidden {{validation}}" id="{{field_id}}" type="text" name="{{name}}" {{validation}}>{{value}}</textarea>
  {% comment %} Inside is the JS powered rich text interface which is intialised when the textarea comes into view. {% endcomment %}
  <div data-fb-mde="{{field_id}}">
    {% include "modules/module_357/front_end/v1/flowbite_rich_text", name: name, id: field_id, label: label, value: value, validation: validation, attributes: attributes, wrapper_class: nil, readonly_class: nil, label_class: nil, readonly: false %}
  </div>
{% else %}
<div class="col-span-full">
  <div class="">
    <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300" for="{{field_id}}">{{label}} {% if validation contains 'required' %}<span>*</span>{% endif %}</label>
    <textarea {{attributes}} id="{{field_id}}" name="{{name}}" {% if label != blank %}data-sg-validation-label="{{label}}" data-sg-validation-id="{{field_id}}" {% endif %} class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-info-500 focus:border-info-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-info-500 dark:focus:border-info-500 {{validation}} {% if validation != blank %}valid:bg-success-50 valid:border valid:border-success-500 valid:text-success-900 valid:placeholder-success-700 valid:text-sm valid:rounded-lg valid:focus:ring-success-500 valid:focus:border-success-500   dark:valid:bg-gray-700  dark:valid:border-success-400  group-focus-within:invalid:bg-danger-50 group-focus-within:invalid:border group-focus-within:invalid:border-danger-500 group-focus-within:invalid:text-danger-900 group-focus-within:invalid:placeholder-danger-700 group-focus-within:invalid:focus:ring-danger-500  dark:group-focus-within:invalid:bg-gray-700 group-focus-within:invalid:focus:border-danger-500  dark:group-focus-within:invalid:text-danger-500  dark:group-focus-within:invalid:placeholder-danger-500  dark:group-focus-within:invalid:border-danger-500{% endif %}" type="text" {{validation}} placeholder="Your {{label}}">{{value}}</textarea>
  </div>
</div>
{% endif %}