
  {% function settings = "modules/module_86/front_end/functions/v1/get_table_config", model_type: 'module', id: '3' %}
  {% assign anyone_can_edit = settings.anyone_can_edit %}
  {% assign secure_zone_match = false %}
  {% if secure_zone_ids_can_edit != blank %}
    {% assign secure_zone_ids_can_edit = secure_zone_ids_can_edit | split: "," %}
    {% for sz in secure_zone_ids_can_edit %}
      {% if context.exports.current_user['Secure Zones'] contains sz %}
        {% assign secure_zone_match = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
  {% if secure_zone_match == true and anyone_can_edit == true %}
    {% assign allow_edit = true %}
  {% elsif anyone_can_edit == true and secure_zone_ids_can_edit == blank %}
    {% assign allow_edit = true %}
  {% elsif context.current_user.id == context.exports.module_3.data.result.items[0].creator.id %}
    {% assign allow_edit = true %}
  {% endif %}
  {% if allow_edit == true %}
    
  {% else %}
    <section class=" ">
      <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
        <div class="mx-auto max-w-screen-sm text-center">
          <h1 class="mb-4 text-7xl tracking-tight font-extrabold lg:text-9xl text-primary-600 dark:text-primary-500">401</h1>
          <p class="mb-4 text-3xl tracking-tight font-bold text-gray-900 md:text-4xl dark:text-white">Not authorized to edit.</p>
        </div>
      </div>
    </section>
  {% endif %}
  {%- include 'module_form_edit', id: '3', layout: layout, enabled: 'true', resource_id: this.id -%}
