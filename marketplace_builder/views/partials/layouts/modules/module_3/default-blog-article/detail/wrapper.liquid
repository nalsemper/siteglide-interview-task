---
  {% comment %}---Settings---{% endcomment %}
  {% comment %}------Insert your Blog List View URL here to go there for sorting, searching and filtering results.  {% endcomment %}
  {% assign blog_list_page_url = settings.blog_list_page_url | default: "/blog" %}
  {% comment %}------Show a sidebar?  {% endcomment %}
  {% assign sidebar = settings.sidebar | default: true %}
  {% comment %} Default (null) is to show all categories in the sidebar. Alternatively, pass in an id (in quotes e.g. '6') for a category which is the parent of blog categories to only show relevant categories. {% endcomment %}
  {% assign blog_parent_category = settings.blog_parent_category | downcase | default: null %}
  {% comment %} ------Secure Zone IDs can Edit------ 
  Visiting the page with ?edit=true at the end of the URL will show an edit form under certain conditions. If in the module_settings anyone_can_edit is set to true, you may wish to restrict access a little more- in which case you can add comma-separated secure zone IDs here- users who don't have any of the secure zones in this list will not have access to the form. (The default values are not real Secure Zones, just an example). {% endcomment %}
  {% assign secure_zone_ids_can_edit = settings.secure_zone_ids_can_edit | default: '' %}
  
  {% comment %}---End Settings---{% endcomment %}
  {% capture sitebuilder_uniq_component_id %}sitegurus_component_{% increment sitegurus_gen_uniq_component_id %}{% endcapture %}
  {% if context.params.edit == 'true' %}
    {%- include 'modules/siteglide_system/get/get_items', item_layout: 'edit' -%}
  {% else %}
    {%- include 'modules/siteglide_system/get/get_items', item_layout: 'item' -%}
  {% endif %}
