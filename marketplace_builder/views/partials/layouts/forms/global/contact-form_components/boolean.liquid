<fieldset>
  <legend class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300">{{label}} {% if validation contains 'required' %}<span>*</span>{% endif %}</legend>
  <div {{attributes}} class="boolean {{validation}} flex items-center mb-4">
    <input {{attributes}} {% if value == true or value == "true" %}checked{% endif %} class="w-4 h-4 text-info-600 bg-gray-100 rounded border-gray-300 focus:ring-info-500 dark:focus:ring-info-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600 {{validation}} {% if validation != blank %} valid:border valid:border-success-500 valid:text-success-900 valid:placeholder-success-700   valid:focus:ring-success-500 valid:focus:border-success-500   dark:valid:bg-gray-700  dark:valid:border-success-400  group-focus-within:invalid:text-danger-700  dark:group-focus-within:invalid:text-danger-500 group-focus-within:invalid:border group-focus-within:invalid:border-danger-500 group-focus-within:invalid:focus:ring-danger-500 group-focus-within:invalid:focus:border-danger-500  dark:group-focus-within:invalid:border-danger-500{% endif %}" type="checkbox" name="{{name}}" {% if label != blank %}data-sg-validation-label="{{label}}" data-sg-validation-id="{{field_id}}" {% endif %} id="{{field_id}}_true" value="true">
    <label class="sr-only" for="{{field_id}}_true">true</label>
  </div>
</fieldset>

