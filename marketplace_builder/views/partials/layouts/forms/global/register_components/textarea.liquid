{% if attributes contains 'data-sg-rich-text' %}
  {% comment %} Inside is the JS powered rich text interface which is intialised when the textarea comes into view. {% endcomment %}
  <div data-fb-mde="{{field_id}}">
    {% include "modules/module_357/front_end/v1/flowbite_rich_text", name: name, id: field_id, label: label, value: value, validation: validation, attributes: attributes, wrapper_class: nil, readonly_class: nil, label_class: nil, readonly: false %}
  </div>
{% else %}
  <div class="col-span-full">
    <div class="">
      <label class="mb-2 block text-sm font-medium text-base-900 dark:text-base-200" for="{{field_id}}">{{label}} {% if validation contains 'required' %}<span>*</span>{% endif %}</label>
      <textarea {{attributes}} id="{{field_id}}" name="{{name}}" {% if label != blank %}data-sg-validation-label="{{label}}" data-sg-validation-id="{{field_id}}" {% endif %} class="block w-full rounded-lg border border-base-200 bg-base-50 p-2.5 text-sm text-base-900 focus:border-primary-500 focus:ring-primary-500 dark:border-base-700 dark:bg-base-900/40 dark:placeholder-base-500 dark:text-base-100 dark:focus:border-primary-500 dark:focus:ring-primary-500 {{validation}} {% if validation != blank %}valid:border valid:border-success-500 valid:bg-success-50 valid:text-success-900 valid:placeholder-success-700 valid:text-sm valid:rounded-lg valid:focus:ring-success-500 valid:focus:border-success-500 dark:valid:bg-base-900/40 dark:valid:border-success-400 group-focus-within:invalid:bg-danger-50 group-focus-within:invalid:border group-focus-within:invalid:border-danger-500 group-focus-within:invalid:text-danger-900 group-focus-within:invalid:placeholder-danger-700 group-focus-within:invalid:focus:ring-danger-500 dark:group-focus-within:invalid:bg-base-900/40 group-focus-within:invalid:focus:border-danger-500 dark:group-focus-within:invalid:text-danger-500 dark:group-focus-within:invalid:placeholder-danger-500 dark:group-focus-within:invalid:border-danger-500{% endif %}" type="text" {{validation}}>{{value}}</textarea>
    </div>
  </div>
{% endif %}
