<fieldset {{attributes}} class=" radio-container {{validation}} col-span-6 sm:col-full">
  {% if options.size > 1 %}<legend class="col-block mb-2 text-sm font-medium text-base-900 dark:text-base-200 ">{{label}} {% if validation contains 'required' %}<span>*</span>{% endif %}</legend>{% endif %}
  {% for option in options %}
    <div class="flex items-center {% unless forloop.last %}mb-4{% endunless %}">
      <input {% if value == option %}checked{% endif %} class="w-4 h-4 text-primary-600 bg-base-100 border-base-200 focus:ring-primary-500 dark:focus:ring-primary-600 dark:ring-offset-base-900 focus:ring-2 dark:bg-base-900/40 dark:border-base-700  {% if validation != blank %} valid:border valid:border-success-500 valid:text-success-900 valid:placeholder-success-700   valid:focus:ring-success-500 valid:focus:border-success-500   dark:valid:bg-base-900/40  dark:valid:border-success-400  group-focus-within:invalid:text-danger-700  dark:group-focus-within:invalid:text-danger-500 group-focus-within:invalid:border group-focus-within:invalid:border-danger-500 group-focus-within:invalid:focus:ring-danger-500 group-focus-within:invalid:focus:border-danger-500  dark:group-focus-within:invalid:border-danger-500{% endif %}" type="radio" name="{{name}}" {% if label != blank %}data-sg-validation-label="{{label}}" data-sg-validation-id="{{field_id}}" {% endif %} id="{{field_id}}_{{option}}" value="{{option}}">
      {% comment %} valid:bg-success-50 {% endcomment %}
      <label class="ml-2 text-sm font-medium text-base-900 dark:text-base-200" for="{{field_id}}_{{option}}">{% if options.size > 1 %}{{option}}{% else %}{{label}}{% endif %}</label>
    </div>
  {% endfor %}
</fieldset>
