---
metadata:
  name: CTA Section
  class: section
  lists: []
  fields:
  - id: eyebrow
    type: text
    label: Eyebrow
    default: ''
  - id: heading
    type: textarea
    label: Heading
    default: Let's find more that brings us together.
  - id: body
    type: textarea
    label: Body
    default: Flowbite helps you connect with friends, family and communities of people
      who share your interests. Connecting with your friends and family as well as
      discovering new ones is easy with features like Groups, Watch and Marketplace.
  - id: button_one_text
    type: text
    label: Button One Text
    default: Get started
  - id: button_one_url
    type: url
    label: Button One URL
    default: "#"
  - id: button_two_text
    type: text
    label: Button Two Text
    default: View more
  - id: button_two_url
    type: url
    label: Button Two URL
    default: "#"
  hide_on: []
  category: cta
  requires: []
  settings: []
  collection: flowbite_free
  components: []
---
<section class="@container  {{selection-index}}" data-motion-group>
  <div class="container" data-motion-group>

    {% if this.eyebrow != blank %}
      <p class="eyebrow_text" data-motion-text>{{ this.eyebrow }}</p>
    {% endif %}
    <h2 class="max-w-3xl" data-motion-text>{{ this.heading }}</h2>
    {% if this.body != blank %}
      <p class="max-w-xl" data-motion-text>{{ this.body }}</p>
    {% endif %}

    <div class="mt-8 flex flex-wrap items-center gap-4" data-motion-group>
      {% if this.button_one_text != blank %}
        <a href="{{ this.button_one_url }}" class="button">{{ this.button_one_text }}</a>
      {% endif %}
      {% if this.button_two_text != blank %}
        <a href="{{ this.button_two_url }}" class="button-secondary">{{ this.button_two_text }}</a>
      {% endif %}
    </div>

  </div>
</section>
