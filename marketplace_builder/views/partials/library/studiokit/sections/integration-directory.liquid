---
metadata:
  name: Integration Directory
  class: section
  lists:
  - name: Integrations
    type: integrations
    fields:
    - id: integration_name
      type: text
      label: Integration Name
      default: Studio
      is_title: true
    - id: integration_category
      type: text
      label: Integration Category
      default: Core
    - id: integration_summary
      type: textarea
      label: Integration Summary
      default: Build pages with reusable sections and role-friendly workflows.
    - id: integration_status
      type: text
      label: Integration Status
      default: Included
    - id: integration_cta_label
      type: text
      label: CTA Label
      default: Explore
    - id: integration_cta_url
      type: url
      label: CTA URL
      default: "#"
  fields:
  - id: eyebrow
    type: text
    label: Eyebrow
    default: BUILDERS AND TOOLS
  - id: heading
    type: textarea
    label: Heading
    default: One integration directory for every Siteglide workflow.
  - id: body
    type: textarea
    label: Body
    default: Browse core builders and platform tools your team can combine to launch
      faster and manage projects with less friction.
  - id: filter_label
    type: text
    label: Filter Label
    default: Filter by category
  - id: all_label
    type: text
    label: All Filter Label
    default: All
  - id: note
    type: text
    label: Footer Note
    default: Tip, each builder is designed to work together, not as disconnected plugins.
  hide_on: []
  category: content
  requires: []
  settings: []
  collection: studiokit
---
<section class=" {{selection-index}}" data-ui-kit-integration-directory data-motion-group>
  <div class="container">

    <div class="max-w-3xl" data-motion-group>
      <p class="text-sm font-semibold uppercase tracking-[0.12em] text-base-600 dark:text-base-300 opacity-60" data-motion-text>{{ this.eyebrow }}</p>
      <h2 data-motion-text>{{ this.heading }}</h2>
      <p data-motion-text>{{ this.body }}</p>
    </div>

    <div class="card mt-8 rounded-2xl bg-base-50 dark:bg-base-900/20 p-4 md:p-5" data-motion-card>
      <div class="flex flex-row flex-wrap items-center justify-between gap-3">
        <p class="flex-none text-xs uppercase tracking-[0.12em] text-neutral-500">{{ this.filter_label }}</p>
        <div class="flex flex-1 flex-wrap items-center gap-2 md:justify-end" data-integration-filters>
          <button type="button" class="int-filter-btn rounded-sm border border-primary-500/60 bg-primary-500/15 px-3 py-1.5 text-xs uppercase tracking-[0.12em] text-primary-400" data-filter="all" aria-label="Show all integrations">
            {{ this.all_label }}
          </button>
          {% assign seen_categories = '|' %}
          {% for item in lists.integrations %}
            {% assign normalized_category = item.integration_category | downcase | strip %}
            {% capture category_key %}|{{ normalized_category }}|{% endcapture %}
            {% if normalized_category != blank %}
              {% unless seen_categories contains category_key %}
                {% assign seen_categories = seen_categories | append: normalized_category | append: '|' %}
                <button type="button" class="int-filter-btn rounded-sm border border-base-50 px-3 py-1.5 text-xs uppercase tracking-[0.12em] text-neutral-100 transition-colors duration-150 hover:border-primary-500/40 hover:text-neutral-100" data-filter="{{ normalized_category | escape }}" aria-label="Filter by {{ item.integration_category }}">
                  {{ item.integration_category }}
                </button>
              {% endunless %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3" data-integration-grid>
      {% for item in lists.integrations %}
        {% assign category_value = item.integration_category | downcase | strip %}
        <article data-studio-list="{{ item._list }}" data-integration-card data-category="{{ category_value | escape }}" class="card rounded-2xl bg-base-50 dark:bg-base-900/20 p-6" data-motion-card>
          <div class="flex items-center justify-between gap-3">
            <p class="text-xs uppercase tracking-[0.12em] text-primary-400 !mb-0">{{ item.integration_category }}</p>
            {% if item.integration_status != blank %}
              <span class="rounded-sm border border-base-200 dark:border-base-600 px-2.5 py-1 text-xs uppercase tracking-[0.11em] text-neutral-500">{{ item.integration_status }}</span>
            {% endif %}
          </div>
          <h3 class="mt-4">{{ item.integration_name }}</h3>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">{{ item.integration_summary }}</p>
          <a href="{{ item.integration_cta_url }}" class="button-secondary mt-5 w-full justify-center">{{ item.integration_cta_label }}</a>
        </article>
      {% endfor %}
    </div>

    {% if this.note != blank %}
      <p class="mt-8 text-xs uppercase tracking-[0.12em] text-neutral-500">{{ this.note }}</p>
    {% endif %}

  </div>
</section>

<script>
(function () {
  document.querySelectorAll('[data-ui-kit-integration-directory]').forEach(function (section) {
    if (section.dataset.integrationReady === 'true') return;

    var filterButtons = Array.from(section.querySelectorAll('[data-filter]'));
    var cards = Array.from(section.querySelectorAll('[data-integration-card]'));
    if (!filterButtons.length || !cards.length) return;

    function setActiveButton(activeButton) {
      filterButtons.forEach(function (button) {
        var isActive = button === activeButton;
        button.classList.toggle('border-primary-500/60', isActive);
        button.classList.toggle('bg-primary-500/15', isActive);
        button.classList.toggle('text-primary-400', isActive);
        button.classList.toggle('border-base-50', !isActive);
        button.classList.toggle('text-neutral-100', !isActive);
      });
    }

    function applyFilter(filterValue) {
      cards.forEach(function (card) {
        var category = (card.getAttribute('data-category') || '').trim();
        var showCard = filterValue === 'all' || category === filterValue;
        card.classList.toggle('hidden', !showCard);
      });
    }

    filterButtons.forEach(function (button) {
      button.addEventListener('click', function () {
        var filterValue = (button.getAttribute('data-filter') || 'all').trim();
        setActiveButton(button);
        applyFilter(filterValue);
      });
    });

    setActiveButton(filterButtons[0]);
    applyFilter('all');
    section.dataset.integrationReady = 'true';
  });
})();
</script>
