---
metadata:
  name: Content Image Split List
  class: section
  lists:
  - name: Cards
    type: content_cards
    fields:
    - id: card_heading
      type: text
      label: Card Heading
      default: Built for teams shipping meaningful products
      is_title: true
    - id: card_description
      type: textarea
      label: Card Description
      default: We combine strategy, product design, and development to deliver outcomes
        your customers can feel.
    - id: card_image
      type: image_picker
      label: Card Image
      default: ''
    - id: card_image_alt
      type: text
      label: Card Image Alt
      default: Content card image
    - id: card_cta_label
      type: text
      label: Card CTA Label
      default: Learn More
    - id: card_cta_url
      type: url
      label: Card CTA URL
      default: "#"
  fields:
  - id: eyebrow
    type: text
    label: Eyebrow
    default: CONTENT BLOCKS
  - id: heading
    type: textarea
    label: Section Heading
    default: Story-led sections that balance visuals and clear messaging.
  - id: body
    type: textarea
    label: Section Body
    default: Use this section for services, differentiators, product highlights, or
      case-study snippets.
  hide_on: []
  category: content
  requires: []
  settings: []
  collection: studiokit
---
<section class=" {{selection-index}}" data-motion-group>
  <div class="container">

    {% if this.eyebrow != blank or this.heading != blank or this.body != blank %}
      <div class="max-w-3xl mb-12" data-motion-group>
        {% if this.eyebrow != blank %}
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-base-600 dark:text-base-300 opacity-60" data-motion-text>{{ this.eyebrow }}</p>
        {% endif %}
        {% if this.heading != blank %}
          <h2 data-motion-text>{{ this.heading }}</h2>
        {% endif %}
        {% if this.body != blank %}
          <p data-motion-text>{{ this.body }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="flex flex-col gap-6">
      {% for item in lists.content_cards %}
        {% assign item_mod = forloop.index0 | modulo: 2 %}
        <article data-studio-list="{{ item._list }}" class="card rounded-2xl bg-base-50 dark:bg-base-900/20 p-6 md:p-8" data-motion-card>
          <div class="grid gap-6 {% if item.card_image != blank %}lg:grid-cols-2 lg:items-center{% endif %}">

            {% if item.card_image != blank %}
              <div class="{% if item_mod == 1 %}lg:order-2{% endif %}">
                <div class="overflow-hidden">
                  {% include 'img',
                    path: item.card_image,
                    classes: 'h-64 w-full object-cover md:h-72 lg:h-[26rem]',
                    attributes: 'alt="{{ item.card_image_alt | default: item.card_heading }}" loading="lazy"'
                  %}
                </div>
              </div>
            {% endif %}

            <div class="{% if item.card_image != blank and item_mod == 1 %}lg:order-1{% endif %}">
              {% if item.card_heading != blank %}
                <h3 data-motion-text>{{ item.card_heading }}</h3>
              {% endif %}
              {% if item.card_description != blank %}
                <p class="mt-3 text-neutral-400" data-motion-text>{{ item.card_description }}</p>
              {% endif %}
              {% if item.card_cta_label != blank and item.card_cta_url != blank %}
                <a href="{{ item.card_cta_url }}" class="button-secondary mt-6">{{ item.card_cta_label }}</a>
              {% endif %}
            </div>

          </div>
        </article>
      {% endfor %}
    </div>

  </div>
</section>
