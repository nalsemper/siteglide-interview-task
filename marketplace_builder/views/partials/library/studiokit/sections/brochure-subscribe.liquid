---
metadata:
  name: Brochure Subscribe
  tags:
  class: section
  lists: []
  fields:
  - id: heading_left
    type: textarea
    label: Left Heading
    default: Exceptional glazing for those who build with vision.
  - id: heading_right
    type: textarea
    label: Right Heading
    default: Claim your free brochure. Subscribe
  - id: cta_label
    type: text
    label: CTA Label
    default: CONTACT NOW
  - id: cta_url
    type: url
    label: CTA URL
    default: "#"
  - id: preview_image
    type: image_picker
    label: Preview Image
    default: ''
  hide_on: []
  category: Content
  requires: []
  settings: []
  collection: mono
  components: []
  updated_at: 1781877718
  global_data:
  global_fields: []
---
<section class="@container  {{selection-index}}" data-motion-group>
  <div class="container py-6">
    <div class="relative overflow-hidden border min-h-[640px] @md:h-[694px] p-4 @sm:p-6 @md:p-0 flex flex-col gap-6 @md:block" data-motion-card>
      <div class="hidden @md:block absolute left-0 top-0 h-full w-[57%] border-r"></div>

      {% if this.preview_image != blank %}
        {% include 'img',
          path: this.preview_image,
          classes: 'w-full aspect-[4/5] @sm:aspect-[5/6] @md:w-72 @md:h-[436px] object-cover @md:absolute @md:left-8 @md:bottom-8',
          attributes: 'alt="{{ this.heading_left }}" loading="lazy"'
        %}
      {% endif %}

      <h2 class="max-w-full @md:max-w-[460px] @md:absolute @md:left-8 @md:top-8" data-motion-text>{{ this.heading_left }}</h2>

      <h2 class="text-left @md:text-right max-w-full @md:max-w-[380px] @md:absolute @md:right-8 @md:top-1/2 @md:-translate-y-1/2" data-motion-text>{{ this.heading_right }}</h2>

      <a href="{{ this.cta_url }}" class="button inline-flex items-center gap-2 @md:absolute @md:left-1/2 @md:bottom-8 @md:-translate-x-1/2" data-motion-text>
        <span>{{ this.cta_label }}</span>
        <svg aria-hidden="true" class="w-5 h-5 -rotate-45" viewBox="0 0 24 24" fill="none">
          <path d="M3 12h17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M13 4l8 8-8 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <div class="@md:absolute @md:right-8 @md:bottom-8 w-full @md:w-auto" data-motion-text>
        <div class="w-full @md:w-[466px] h-[56px] @md:h-[62px] flex items-center justify-between pl-4 @sm:pl-6 @md:pl-7 pr-[3px] rounded-sm border bg-base-50 dark:bg-base-950">
          <span class="text-sm leading-none">Email</span>
          <span class="w-[50px] h-[50px] @md:w-[56px] @md:h-[56px] rounded-sm flex items-center justify-center bg-primary-500">
            <span class="w-8 h-8 border-4 border-white/60 rounded-full"></span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
