      type: text
      label: Link Text
      default: Workflow Management
    - id: link_url
      type: url
      label: Link URL
      default: "#"
  - name: Column 2 Links
    type: sitegurus_footer_resources
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Blog
    - id: link_url
      type: url
      label: Link URL
      default: "#"
  - name: Column 3 Links
    type: sitegurus_footer_enterprise
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Overview
    - id: link_url
      type: url
      label: Link URL
      default: "#"
  - name: Column 4 Links
    type: sitegurus_footer_usecases
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Video
    - id: link_url
      type: url
      label: Link URL
      default: "#"
  - name: Column 5 Links
    type: sitegurus_footer_company
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Talk with Sales
    - id: link_url
      type: url
      label: Link URL
      default: "#"
  fields:
  - id: col_1_heading
    type: text
    label: Column 1 Heading
    default: ''
  - id: col_2_heading
    type: text
    label: Column 2 Heading
    default: ''
  - id: col_3_heading
    type: text
    label: Column 3 Heading
    default: ''
  - id: col_4_heading
    type: text
    label: Column 4 Heading
    default: ''
  - id: col_5_heading
    type: text
    label: Column 5 Heading
    default: ''
  - id: copyright_year
    type: text
    label: Copyright Year
    default: ''
  - id: copyright_company
    type: text
    label: Copyright Company Name
    default: Platform Inc.
  - id: terms_label
    type: text
    label: Terms Label
    default: Terms
  - id: terms_url
    type: url
    label: Terms URL
    default: "#"
  - id: privacy_label
    type: text
    label: Privacy Label
    default: Privacy
  - id: privacy_url
