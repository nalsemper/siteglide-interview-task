---
metadata:
  name: Team Grid
  class: section
  lists:
  - name: Team Members
    type: team_members
    fields:
    - id: name
      type: text
      label: Name
      default: Bonnie Green
      is_title: true
    - id: job_title
      type: text
      label: Job Title
      default: CEO/Co-founder
    - id: photo
      type: image_picker
      label: Photo
      default: ''
    - id: profile_url
      type: url
      label: Profile URL
      default: "#"
    - id: facebook_url
      type: url
      label: Facebook URL
      default: "#"
    - id: twitter_url
      type: url
      label: Twitter URL
      default: "#"
    - id: github_url
      type: url
      label: GitHub URL
      default: "#"
    - id: dribbble_url
      type: url
      label: Dribbble URL
      default: "#"
  fields:
  - id: eyebrow
    type: text
    label: Eyebrow
    default: ''
  - id: heading
    type: textarea
    label: Heading
    default: Our team
  - id: body
    type: textarea
    label: Body
    default: Explore the whole collection of open-source web components and elements
      built with the utility classes from Tailwind.
  hide_on: []
  category: team
  requires: []
  settings: []
  collection: flowbite_free
  components: []
---
<section class="@container  {{selection-index}}" data-motion-group>
  <div class="container">

    <div class="mx-auto max-w-2xl text-center" data-motion-group>
      {% if this.eyebrow != blank %}
        <p class="eyebrow_text" data-motion-text>{{ this.eyebrow }}</p>
      {% endif %}
      <h2 data-motion-text>{{ this.heading }}</h2>
      {% if this.body != blank %}
        <p class="mx-auto" data-motion-text>{{ this.body }}</p>
      {% endif %}
    </div>

    <div class="mt-12 grid gap-8 @sm:grid-cols-2 @md:grid-cols-3 @lg:grid-cols-4" data-motion-group>
      {% for item in lists.team_members %}
        <div class="flex flex-col items-center text-center" data-studio-list="{{ item._list }}" data-motion-card>
          {% if item.photo != blank %}
            {% include 'img',
              path: item.photo,
              classes: 'mx-auto mb-4 h-36 w-36 rounded-full object-cover',
              attributes: 'alt="{{ item.name }} Avatar" loading="lazy"'
            %}
          {% endif %}
          <h3 class="!mb-1" data-motion-text>
            <a href="{{ item.profile_url | default: '#' }}" class="transition-colors hover:text-primary-500">{{ item.name }}</a>
          </h3>
          <p class="!mb-4 text-sm text-neutral-500 dark:text-neutral-400" data-motion-text>{{ item.job_title }}</p>
          <div class="flex items-center gap-4">
            {% if item.facebook_url != blank %}
              <a href="{{ item.facebook_url }}" class="text-neutral-400 transition-colors hover:text-neutral-900 dark:hover:text-neutral-50" aria-label="Facebook">
                <iconify-icon icon="mdi:facebook" width="20" aria-hidden="true"></iconify-icon>
              </a>
            {% endif %}
            {% if item.twitter_url != blank %}
              <a href="{{ item.twitter_url }}" class="text-neutral-400 transition-colors hover:text-neutral-900 dark:hover:text-neutral-50" aria-label="Twitter">
                <iconify-icon icon="mdi:twitter" width="20" aria-hidden="true"></iconify-icon>
              </a>
            {% endif %}
            {% if item.github_url != blank %}
              <a href="{{ item.github_url }}" class="text-neutral-400 transition-colors hover:text-neutral-900 dark:hover:text-neutral-50" aria-label="GitHub">
                <iconify-icon icon="mdi:github" width="20" aria-hidden="true"></iconify-icon>
              </a>
            {% endif %}
            {% if item.dribbble_url != blank %}
              <a href="{{ item.dribbble_url }}" class="text-neutral-400 transition-colors hover:text-neutral-900 dark:hover:text-neutral-50" aria-label="Dribbble">
                <iconify-icon icon="mdi:dribbble" width="20" aria-hidden="true"></iconify-icon>
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>
