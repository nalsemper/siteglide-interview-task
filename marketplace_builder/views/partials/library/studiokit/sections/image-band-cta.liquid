<section class="@container  {{selection-index}} relative h-[100vh] overflow-hidden bg-neutral-950">
  {% if this.background_image != blank %}
    <div class="absolute inset-0">
      {% include 'img',
        path: this.background_image,
        classes: 'w-full h-full object-cover',
        attributes: 'alt="" aria-hidden="true" loading="lazy"'
      %}
    </div>
  {% endif %}
  <div class="absolute inset-0 bg-neutral-950/30"></div>
</section>
