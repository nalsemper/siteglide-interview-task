---
metadata:
  name: Mono
---
/* studio ui kit */
/* ==========================================================================
   ROUNDED OVERRIDES
   ========================================================================== */

@layer utilities {
  .container {
    @apply mx-auto max-w-[96rem] px-8 py-20 md:px-12 md:py-24 lg:px-16 
  }
  .card {
    @apply rounded-none ;
  }
}

/* ==========================================================================
   BASE STYLES
   ========================================================================== */

@layer base {

  /* ==========================================================================
     BODY
     ========================================================================== */

  body {
    @apply bg-base-100 dark:bg-base-900 text-[var(--color-neutral-500)] dark:text-[var(--color-neutral-50)] antialiased;
  }

section {
  @apply bg-base-100 dark:bg-base-950 w-full mx-auto min-[2560px]:max-w-[130rem];
}

  /* ==========================================================================
     HEADINGS
     ========================================================================== */

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-heading text-[var(--color-neutral-950)] dark:text-[var(--color-neutral-50)];
  }

  /* ==========================================================================
     H1
     Hero / Landing Headline
     ========================================================================== */

  h1 {
    @apply text-5xl sm:text-5xl md:text-6xl lg:text-7xl font-medium tracking-[-0.06em] leading-[0.95] mb-8;

    word-spacing: 0.08em;
  }

  /* ==========================================================================
     H2
     Section Headline
     ========================================================================== */

  h2 {
    @apply text-3xl sm:text-4xl md:text-5xl font-medium tracking-[-0.05em] leading-[1] mb-6;

    word-spacing: 0.05em;
  }

  /* ==========================================================================
     H3
     Feature / Card Headline
     ========================================================================== */

  h3 {
    @apply text-2xl sm:text-3xl font-medium tracking-[-0.04em] leading-[1.1] mb-4;
  }

  /* ==========================================================================
     H4
     Subsection Heading
     ========================================================================== */

  h4 {
    @apply text-lg
		sm:text-xl
		font-medium
		tracking-[-0.03em]
		leading-snug
		mb-3;
  }

  /* ==========================================================================
     H5
     UI Heading / Label Heading
     ========================================================================== */

  h5 {
    @apply text-base
		sm:text-lg
		font-medium
		tracking-tight
		leading-normal
		mb-2;
  }

  /* ==========================================================================
     H6
     Eyebrow / Meta Heading
     ========================================================================== */

  h6 {
    @apply text-xs
		sm:text-sm
		uppercase
		font-semibold
		tracking-[0.12em]
		text-[var(--color-neutral-500)]
		dark:text-[var(--color-neutral-400)]
		leading-normal
		mb-2;
  }

  /* ==========================================================================
     TEXT
     ========================================================================== */

  p {
    @apply text-[var(--color-neutral-700)]
		dark:text-[var(--color-neutral-50)]
		md:text-lg
		max-w-md
		mb-0
		leading-[28px]
		font-light;
  }

  strong {
    @apply text-[var(--color-neutral-950)] font-medium;
  }

  em {
    @apply italic;
  }

  small {
    @apply text-[var(--color-neutral-500)]
 dark:text-[var(--color-neutral-50)]
 text-xs;
  }

  /* ==========================================================================
     LISTS
     ========================================================================== */

  ul,
  ol {
    @apply pl-5
 text-[var(--color-neutral-950)]
 dark:text-[var(--color-neutral-50)]
 text-sm;
  }

  li {
    @apply mb-1.5;
  }

  /* ==========================================================================
     IMAGES
     ========================================================================== */

  img {
    @apply max-w-full
 h-auto
 rounded-[0rem];
  }

  /* ==========================================================================
     BUTTONS & LINKS
     ========================================================================== */

  .button,
  button {
    @apply inline-flex
 items-center
 justify-center
 bg-[var(--color-primary-900)]
 text-[var(--color-base-50)]
 border
 border-[var(--color-primary-strong)]
 px-8
 py-5
 rounded-[0rem]
 text-sm
 font-medium
 transition-colors
 duration-150;
  }

  .button:hover,
  button:hover {
    @apply bg-[var(--color-primary-700)];
  }

  .button:active,
  button:active {
    @apply opacity-90;
  }

  .button-secondary {
    @apply inline-flex
 items-center
 justify-center
 gap-2
 !bg-transparent
 text-[var(--color-neutral-600)]
 dark:text-[var(--color-neutral-50)]
 border
 border-[var(--color-neutral-400)]
 px-8
 py-5
 rounded-[0rem]
 text-sm
 font-medium
 transition-colors
 duration-150;
  }

  .button-secondary:hover {
    @apply !bg-[var(--color-base-200)] dark:!bg-[var(--color-base-900)];
  }

  .button-secondary:active {
    @apply opacity-90;
  }

  .card {
  }

  /* ==========================================================================
     FORMS
     ========================================================================== */

  label {
    @apply block
 text-xs
 font-medium
 text-[var(--color-neutral-500)]
 dark:text-[var(--color-neutral-50)]
 mb-1.5;
  }

  input,
  textarea,
  select {
    @apply w-full
 bg-[var(--color-neutral-secondary)]
 border
 border-[var(--color-neutral-800)]
 text-[var(--color-neutral-950)]
 px-3
 py-2
 rounded-[0rem]
 text-sm
 outline-none
 transition-all;
  }

  input::placeholder,
  textarea::placeholder {
    @apply text-[var(--color-neutral-500)];
  }

  input:focus,
  textarea:focus,
  select:focus {
    @apply border-[var(--color-primary)];
  }

  /* ==========================================================================
     CODE
     ========================================================================== */

  code {
    @apply bg-[var(--color-neutral-secondary)]
 text-[var(--color-primary)]
 px-1.5
 py-0.5
 rounded-[0rem]
 text-sm;
  }

  pre {
    @apply bg-[var(--color-neutral-secondary)]
 text-[var(--color-neutral-500)]
 p-4
 rounded-[0rem]
 overflow-x-auto
 text-sm;
  }

  /* ==========================================================================
     TABLES
     ========================================================================== */

  table {
    @apply w-full
 border-collapse
 text-[var(--color-neutral-500)]
 text-sm;
  }

  th {
    @apply text-left
 text-[var(--color-neutral-950)]
 border-b
 border-[var(--color-neutral-800)]
 py-2
 font-medium;
  }

  td {
    @apply border-b
 border-[var(--color-neutral-800)]
 py-2;
  }

  /* ==========================================================================
     FOCUS STATES
     ========================================================================== */

  :focus-visible {
    @apply outline-none
 ring-2
 ring-[var(--color-primary)]/40;
  }
}

/* ==========================================================================
   THEME BRIDGES
   Bridge current theme colors so variants can remap them safely
   ========================================================================== */

@theme {

  --radius-xs: 0rem;
  --radius-sm: 0rem;
  --radius-md: 0rem;
  --radius-lg: 0.9rem;
  --radius-xl: 0rem;
  --radius-2xl: 0rem;
  --radius-3xl: 2.4rem;
  --radius-4xl: 3rem;
  --radius-5xl: 3.8rem;
  --radius-6xl: 4.5rem;
  --radius-full: 9999px;

  /* ==========================================================================
     PRIMARY
     ========================================================================== */

  --color-primary-50-bridge: var(--color-primary-50);
  --color-primary-100-bridge: var(--color-primary-100);
  --color-primary-200-bridge: var(--color-primary-200);
  --color-primary-300-bridge: var(--color-primary-300);
  --color-primary-400-bridge: var(--color-primary-400);
  --color-primary-500-bridge: var(--color-primary-500);
  --color-primary-600-bridge: var(--color-primary-600);
  --color-primary-700-bridge: var(--color-primary-700);
  --color-primary-800-bridge: var(--color-primary-800);
  --color-primary-900-bridge: var(--color-primary-900);
  --color-primary-950-bridge: var(--color-primary-950);

  /* ==========================================================================
     SECONDARY
     ========================================================================== */

  --color-secondary-50-bridge: var(--color-secondary-50);
  --color-secondary-100-bridge: var(--color-secondary-100);
  --color-secondary-200-bridge: var(--color-secondary-200);
  --color-secondary-300-bridge: var(--color-secondary-300);
  --color-secondary-400-bridge: var(--color-secondary-400);
  --color-secondary-500-bridge: var(--color-secondary-500);
  --color-secondary-600-bridge: var(--color-secondary-600);
  --color-secondary-700-bridge: var(--color-secondary-700);
  --color-secondary-800-bridge: var(--color-secondary-800);
  --color-secondary-900-bridge: var(--color-secondary-900);
  --color-secondary-950-bridge: var(--color-secondary-950);

  /* ==========================================================================
     NEUTRAL
     ========================================================================== */

  --color-neutral-50-bridge: var(--color-neutral-50);
  --color-neutral-100-bridge: var(--color-neutral-100);
  --color-neutral-200-bridge: var(--color-neutral-200);
  --color-neutral-300-bridge: var(--color-neutral-300);
  --color-neutral-400-bridge: var(--color-neutral-400);
  --color-neutral-500-bridge: var(--color-neutral-500);
  --color-neutral-600-bridge: var(--color-neutral-600);
  --color-neutral-700-bridge: var(--color-neutral-700);
  --color-neutral-800-bridge: var(--color-neutral-800);
  --color-neutral-900-bridge: var(--color-neutral-900);
  --color-neutral-950-bridge: var(--color-neutral-950);

  /* ==========================================================================
     TERTIARY
     ========================================================================== */

  --color-tertiary-50-bridge: var(--color-tertiary-50);
  --color-tertiary-100-bridge: var(--color-tertiary-100);
  --color-tertiary-200-bridge: var(--color-tertiary-200);
  --color-tertiary-300-bridge: var(--color-tertiary-300);
  --color-tertiary-400-bridge: var(--color-tertiary-400);
  --color-tertiary-500-bridge: var(--color-tertiary-500);
  --color-tertiary-600-bridge: var(--color-tertiary-600);
  --color-tertiary-700-bridge: var(--color-tertiary-700);
  --color-tertiary-800-bridge: var(--color-tertiary-800);
  --color-tertiary-900-bridge: var(--color-tertiary-900);
  --color-tertiary-950-bridge: var(--color-tertiary-950);

  /* ==========================================================================
     BASE
     ========================================================================== */

  --color-base-50-bridge: var(--color-base-50);
  --color-base-100-bridge: var(--color-base-100);
  --color-base-200-bridge: var(--color-base-200);
  --color-base-300-bridge: var(--color-base-300);
  --color-base-400-bridge: var(--color-base-400);
  --color-base-500-bridge: var(--color-base-500);
  --color-base-600-bridge: var(--color-base-600);
  --color-base-700-bridge: var(--color-base-700);
  --color-base-800-bridge: var(--color-base-800);
  --color-base-900-bridge: var(--color-base-900);
  --color-base-950-bridge: var(--color-base-950);
}

/* ==========================================================================
   VARIANTS
   ========================================================================== */

@layer utilities {

  /* ==========================================================================
     VARIANT 1
     Default Mapping
     ========================================================================== */

  .variant-1 {

    /* PRIMARY */

    --color-primary-50: var(--color-primary-50-bridge);
    --color-primary-100: var(--color-primary-100-bridge);
    --color-primary-200: var(--color-primary-200-bridge);
    --color-primary-300: var(--color-primary-300-bridge);
    --color-primary-400: var(--color-primary-400-bridge);
    --color-primary-500: var(--color-primary-500-bridge);
    --color-primary-600: var(--color-primary-600-bridge);
    --color-primary-700: var(--color-primary-700-bridge);
    --color-primary-800: var(--color-primary-800-bridge);
    --color-primary-900: var(--color-primary-900-bridge);
    --color-primary-950: var(--color-primary-950-bridge);

    /* SECONDARY */

    --color-secondary-50: var(--color-secondary-50-bridge);
    --color-secondary-100: var(--color-secondary-100-bridge);
    --color-secondary-200: var(--color-secondary-200-bridge);
    --color-secondary-300: var(--color-secondary-300-bridge);
    --color-secondary-400: var(--color-secondary-400-bridge);
    --color-secondary-500: var(--color-secondary-500-bridge);
    --color-secondary-600: var(--color-secondary-600-bridge);
    --color-secondary-700: var(--color-secondary-700-bridge);
    --color-secondary-800: var(--color-secondary-800-bridge);
    --color-secondary-900: var(--color-secondary-900-bridge);
    --color-secondary-950: var(--color-secondary-950-bridge);
  }

  /* ==========================================================================
     VARIANT 2
     Swap Primary & Secondary
     ========================================================================== */

  .variant-2 {

    /* PRIMARY ← SECONDARY */

    --color-primary-50: var(--color-secondary-50-bridge);
    --color-primary-100: var(--color-secondary-100-bridge);
    --color-primary-200: var(--color-secondary-200-bridge);
    --color-primary-300: var(--color-secondary-300-bridge);
    --color-primary-400: var(--color-secondary-400-bridge);
    --color-primary-500: var(--color-secondary-500-bridge);
    --color-primary-600: var(--color-secondary-600-bridge);
    --color-primary-700: var(--color-secondary-700-bridge);
    --color-primary-800: var(--color-secondary-800-bridge);
    --color-primary-900: var(--color-secondary-900-bridge);
    --color-primary-950: var(--color-secondary-950-bridge);

    /* SECONDARY ← PRIMARY */

    --color-secondary-50: var(--color-primary-50-bridge);
    --color-secondary-100: var(--color-primary-100-bridge);
    --color-secondary-200: var(--color-primary-200-bridge);
    --color-secondary-300: var(--color-primary-300-bridge);
    --color-secondary-400: var(--color-primary-400-bridge);
    --color-secondary-500: var(--color-primary-500-bridge);
    --color-secondary-600: var(--color-primary-600-bridge);
    --color-secondary-700: var(--color-primary-700-bridge);
    --color-secondary-800: var(--color-primary-800-bridge);
    --color-secondary-900: var(--color-primary-900-bridge);
    --color-secondary-950: var(--color-primary-950-bridge);
  }

  /* ==========================================================================
     VARIANT 3
     Force Secondary Family To Follow Primary
     ========================================================================== */

  .variant-3 {

    --color-primary-50: var(--color-primary-50-bridge);
    --color-primary-100: var(--color-primary-100-bridge);
    --color-primary-200: var(--color-primary-200-bridge);
    --color-primary-300: var(--color-primary-300-bridge);
    --color-primary-400: var(--color-primary-400-bridge);
    --color-primary-500: var(--color-primary-500-bridge);
    --color-primary-600: var(--color-primary-600-bridge);
    --color-primary-700: var(--color-primary-700-bridge);
    --color-primary-800: var(--color-primary-800-bridge);
    --color-primary-900: var(--color-primary-900-bridge);
    --color-primary-950: var(--color-primary-950-bridge);

    --color-secondary-50: var(--color-primary-50-bridge);
    --color-secondary-100: var(--color-primary-100-bridge);
    --color-secondary-200: var(--color-primary-200-bridge);
    --color-secondary-300: var(--color-primary-300-bridge);
    --color-secondary-400: var(--color-primary-400-bridge);
    --color-secondary-500: var(--color-primary-500-bridge);
    --color-secondary-600: var(--color-primary-600-bridge);
    --color-secondary-700: var(--color-primary-700-bridge);
    --color-secondary-800: var(--color-primary-800-bridge);
    --color-secondary-900: var(--color-primary-900-bridge);
    --color-secondary-950: var(--color-primary-950-bridge);
  }

  /* ==========================================================================
     VARIANT 4
     Primary From Tertiary, Secondary From Neutral
     ========================================================================== */

  .variant-4 {

    /* PRIMARY ← TERTIARY */

    --color-primary-50: var(--color-tertiary-50-bridge);
    --color-primary-100: var(--color-tertiary-100-bridge);
    --color-primary-200: var(--color-tertiary-200-bridge);
    --color-primary-300: var(--color-tertiary-300-bridge);
    --color-primary-400: var(--color-tertiary-400-bridge);
    --color-primary-500: var(--color-tertiary-500-bridge);
    --color-primary-600: var(--color-tertiary-600-bridge);
    --color-primary-700: var(--color-tertiary-700-bridge);
    --color-primary-800: var(--color-tertiary-800-bridge);
    --color-primary-900: var(--color-tertiary-900-bridge);
    --color-primary-950: var(--color-tertiary-950-bridge);

    /* SECONDARY ← NEUTRAL */

    --color-secondary-50: var(--color-neutral-50-bridge);
    --color-secondary-100: var(--color-neutral-100-bridge);
    --color-secondary-200: var(--color-neutral-200-bridge);
    --color-secondary-300: var(--color-neutral-300-bridge);
    --color-secondary-400: var(--color-neutral-400-bridge);
    --color-secondary-500: var(--color-neutral-500-bridge);
    --color-secondary-600: var(--color-neutral-600-bridge);
    --color-secondary-700: var(--color-neutral-700-bridge);
    --color-secondary-800: var(--color-neutral-800-bridge);
    --color-secondary-900: var(--color-neutral-900-bridge);
    --color-secondary-950: var(--color-neutral-950-bridge);
  }

  /* ==========================================================================
     VARIANT 5
     Primary & Secondary From Neutral
     ========================================================================== */

  .variant-5 {

    --color-primary-50: var(--color-neutral-50-bridge);
    --color-primary-100: var(--color-neutral-100-bridge);
    --color-primary-200: var(--color-neutral-200-bridge);
    --color-primary-300: var(--color-neutral-300-bridge);
    --color-primary-400: var(--color-neutral-400-bridge);
    --color-primary-500: var(--color-neutral-500-bridge);
    --color-primary-600: var(--color-neutral-600-bridge);
    --color-primary-700: var(--color-neutral-700-bridge);
    --color-primary-800: var(--color-neutral-800-bridge);
    --color-primary-900: var(--color-neutral-900-bridge);
    --color-primary-950: var(--color-neutral-950-bridge);

    --color-secondary-50: var(--color-neutral-50-bridge);
    --color-secondary-100: var(--color-neutral-100-bridge);
    --color-secondary-200: var(--color-neutral-200-bridge);
    --color-secondary-300: var(--color-neutral-300-bridge);
    --color-secondary-400: var(--color-neutral-400-bridge);
    --color-secondary-500: var(--color-neutral-500-bridge);
    --color-secondary-600: var(--color-neutral-600-bridge);
    --color-secondary-700: var(--color-neutral-700-bridge);
    --color-secondary-800: var(--color-neutral-800-bridge);
    --color-secondary-900: var(--color-neutral-900-bridge);
    --color-secondary-950: var(--color-neutral-950-bridge);
  }
}